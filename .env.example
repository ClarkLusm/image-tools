# Required at build time (NEXT_PUBLIC_* values are inlined into the bundle).
# Base URL of image-tools-api, including the /v1 prefix.
NEXT_PUBLIC_IMAGE_TOOLS_API_URL=http://localhost:3000/v1
# Public URL of this site, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional: Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: verbose image-tools debug logs (server / browser).
DEBUG_IMAGE_TOOLS=
NEXT_PUBLIC_DEBUG_IMAGE_TOOLS=
